# Copie para .env (que o git ignora) e preencha. Nunca commite o .env.
# Chave gratuita em https://api.nasa.gov/ (1.000 requisicoes por hora; a DEMO_KEY so aguenta ~10).

# Usada pelos scripts de coleta (scripts/*.mjs) e pela rota de servidor
# /api/space-weather. Nunca use o prefixo NEXT_PUBLIC_: essas variaveis sao
# incluidas no JavaScript enviado ao navegador.
NASA_API_KEY=
