# Copie para .env (que o git ignora) e preencha. Nunca commite o .env.
# Chave gratuita em https://api.nasa.gov/ (1.000 requisicoes por hora; a DEMO_KEY so aguenta ~10).

# Usada so pelos scripts de coleta (scripts/*.mjs), nunca pelo jogo: sem o prefixo VITE_,
# o Vite nao coloca esta variavel no bundle publicado.
NASA_API_KEY=

# Opcional: chave do fetch AO VIVO do DONKI no navegador (src/data/spaceWeather.js, issue #100).
# ATENCAO: tudo que comeca com VITE_ vai para o bundle e fica visivel para qualquer pessoa.
# Use so uma chave gratuita da api.nasa.gov, de preferencia uma separada da dos scripts.
# Vazio = DEMO_KEY. No GitHub Pages ela vem do secret NASA_API_KEY do repositorio (deploy.yml).
VITE_NASA_API_KEY=
